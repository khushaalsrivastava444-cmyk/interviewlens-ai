# Application Configuration
PROJECT_NAME="InterviewLens AI"
SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite fallback: sqlite:///./interviewlens.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/interviewlens
DATABASE_URL="sqlite:///./interviewlens.db"

# Storage Configuration
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_BYTES=157286400

# AI Model Configuration
AI_PROVIDER="mock"  # options: mock, openai, gemini, huggingface
OPENAI_API_KEY=""
GEMINI_API_KEY=""
WHISPER_MODEL_SIZE="base"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
